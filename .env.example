PROJECT_NAME=KlipperAI
RELOAD=True
LOG_LEVEL=INFO

# Host Configuration
HOST=0.0.0.0
PORT=8000
# Explicit frontend origin(s), JSON array. Must NOT be "*" — the frontend sends
# credentials (cookies) and browsers reject a wildcard on credentialed requests.
ALLOWED_ORIGINS=["http://localhost:8080"]

# 3rd Party API Keys
ASSEMBLYAI_API_KEY=replace_me
OPENAI_API_KEY=replace_me
ELEVEN_LABS_API_KEY=replace_me

# Database Configuration
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Azure Storage Configuration
AZURE_STORAGE_ACCOUNT_NAME=replace_me
AZURE_STORAGE_ACCOUNT_KEY=replace_me
AZURE_STORAGE_CONTAINER_NAME=replace_me
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net

# Thumbnail Storage Configuration
THUMBNAIL_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
THUMBNAIL_STORAGE_ACCOUNT_NAME=replace_me

# Azure Queue Storage
THUMBNAIL_QUEUE_NAME=thumbnail-queue
AZURE_QUEUE_NAME=main-queue
AZURE_QUEUE_P2_TEXT_TO_CONTENT_WORKER=text-to-content-worker

# JWT Authentication
JWT_SECRET_KEY=replace_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30